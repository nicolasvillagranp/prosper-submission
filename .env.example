# LiveKit: the server that hosts the rooms (browser <-> agent audio). Tokens are signed with the key/secret.
LIVEKIT_URL=wss://<your-project>.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
AGENT_NAME=expert

# Speech: Deepgram (speech-to-text) and Cartesia (text-to-speech), called directly
DEEPGRAM_API_KEY=
CARTESIA_API_KEY=

# LLM
ANTHROPIC_API_KEY=

# Morning job: news search
TAVILY_API_KEY=

# Supabase: auth, Postgres, Storage (Project Settings -> API Keys).
# Publishable key (sb_publishable_...): used by the web page. Secret key (sb_secret_...): server only.
SUPABASE_URL=https://<your-project>.supabase.co
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Access and limits
INVITE_CODE=
MAX_USERS=20
MAX_SESSION_MIN=20
DAILY_SESSIONS_PER_USER=15

# Who can open /admin (comma-separated)
ADMIN_EMAILS=

# Who may create an account (comma-separated). Empty = anyone with INVITE_CODE.
ALLOWED_EMAILS=

# Image generation (topic covers)
OPENAI_API_KEY=

